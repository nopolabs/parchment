# Copy to .env (gitignored) and fill in real values, then push with
#   bash scripts/push-secrets.sh
# .env is the source of truth — keep a backup in a password manager.
# Cloudflare's encrypted variables cannot be read back.

# Resend (dashboard > API Keys)
RESEND_API_KEY=

# Per-site issue keys (generate: openssl rand -hex 32).
# Each client site holds the same value as its PARCHMENT_API_KEY /
# <SITE>_PARCHMENT_API_KEY Pages secret.
MTW_ISSUE_API_KEY=
BBPP_ISSUE_API_KEY=
